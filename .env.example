# Copiá este archivo a .env (iniciar.sh / iniciar.ps1 lo hacen solos).
# .env nunca se sube a git: puede tener tokens y keys.

# --- Motor -------------------------------------------------------------------
#   local  -> Whisper + traducción offline. Sin key ni costo; el audio no sale
#             de la máquina. Descarga ~550 MB de modelos la primera vez.
#   gemini -> Gemini Live API de Google (requiere GEMINI_API_KEY).
#   mock   -> subtítulos simulados, para probar la interfaz o el overlay.
CAPTION_ENGINE=local

# Idioma que se habla ("auto" para detectarlo) y al que se traduce, por
# defecto. Cada sesión puede pedir otros desde el panel de emisión.
# Recomendado fijar el idioma hablado: la detección automática se confunde
# con acentos fuertes.
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=es

# --- Seguridad ---------------------------------------------------------------
# Token para emitir audio (panel /admin.html o tools/stream_audio_file.py).
# Si queda vacío, el servidor genera uno distinto en cada arranque y lo
# muestra en el log.
INGEST_TOKEN=

# --- Motor local -------------------------------------------------------------
# tiny | base | small | medium | large-v3 (más grande = mejor y más lento).
WHISPER_MODEL=small
# cpu, o cuda con GPU NVIDIA (fuera de Docker, con CUDA instalado).
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# Inferencias simultáneas entre todas las sesiones.
# LOCAL_MAX_PARALLEL=1

# Traductor: argos (offline, liviano) | ollama (LLM local) | none
TRANSLATOR=argos
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Motor Gemini ------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-live-preview
# GEMINI_MAX_PARALLEL=3

# --- Límites -----------------------------------------------------------------
# MAX_SESSIONS=10
# ARCHIVE_MAX_SESSIONS=50
# MAX_PENDING_SEGMENTS=4
# SEGMENT_MIN_SECONDS=4
# SEGMENT_MAX_SECONDS=10

# Puerto local (solo Docker Compose).
# PORT=8000
